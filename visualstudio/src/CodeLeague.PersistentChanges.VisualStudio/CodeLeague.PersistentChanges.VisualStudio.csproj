<Project>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>CodeLeague.PersistentChanges.VisualStudio</RootNamespace>
    <AssemblyName>CodeLeague.PersistentChanges.VisualStudio</AssemblyName>
    <Version>0.1.0</Version>

    <!-- VSIX packaging -->
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <!-- Write a CodeBase entry into the pkgdef so VS can locate the assembly in the extension folder. -->
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <!-- Only deploy to the experimental instance when building inside Visual Studio (F5). -->
    <DeployExtension Condition="'$(BuildingInsideVisualStudio)' != 'true'">false</DeployExtension>

    <!-- F5 launches the experimental instance -->
    <StartAction>Program</StartAction>
    <StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
  </PropertyGroup>

  <ItemGroup>
    <!-- 17.0 keeps the extension loadable in every Visual Studio 2022 version and in Visual Studio 2026. -->
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.0.32112.339" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Design" />
  </ItemGroup>

  <ItemGroup>
    <!-- The IDE-independent engine is compiled into this assembly so the VSIX ships a single DLL. -->
    <Compile Include="..\CodeLeague.PersistentChanges.Core\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest" SubType="Designer" />
    <VSCTCompile Include="PersistentChangesPackage.vsct" ResourceName="Menus.ctmenu" />
    <Content Include="Resources\Icon.png" IncludeInVSIX="true" />
    <Content Include="..\..\..\LICENSE" Link="LICENSE" IncludeInVSIX="true" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <!-- VSIX packaging (pkgdef, vsct, .vsix); VSToolsPath comes from the Microsoft.VSSDK.BuildTools package. -->
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />

</Project>
